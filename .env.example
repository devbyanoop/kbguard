# Copy this file to .env and fill in real values there. .env is gitignored
# and never committed — only the variable *names* belong in version
# control, never the values (same principle as kbguard.yaml's
# api_key_env: fields, which hold a variable name, not a secret).
#
# .env is loaded automatically by the repo-root conftest.py before any
# test runs (python-dotenv) — nothing else in kbguard reads it.

# Remote Docker host for pgvector/Qdrant contract tests, if not localhost.
# See docs/project/contributing.md.
# KBGUARD_TEST_PG_HOST=
# KBGUARD_TEST_PG_PORT=5434
# KBGUARD_TEST_QDRANT_HOST=
# KBGUARD_TEST_QDRANT_PORT=6333

# Pinecone: needed only for tests/test_adapters_pinecone_live.py, which is
# skipped automatically when these aren't set. Free "Starter" tier is
# enough — see docs/guide/adapters/pinecone.md.
# PINECONE_API_KEY=
# PINECONE_TEST_INDEX=
